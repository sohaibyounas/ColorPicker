{
  "manifest_version": 3,
  "name": "Spectrum Scoop - Color Picker",
  "short_name": "Spectrum Scoop",
  "description": "Pick colors from any page or image. Copy HEX/RGB/HSL instantly.",
  "version": "1.1.0",
  "minimum_chrome_version": "95",
  "action": {
    "default_title": "Spectrum Scoop",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
