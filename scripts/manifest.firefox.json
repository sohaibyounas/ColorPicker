{
  "manifest_version": 3,
  "name": "Spectrum Scoop - Color Picker",
  "short_name": "Spectrum Scoop",
  "description": "Pick colors from images and copy HEX/RGB/HSL instantly. Page color picking depends on browser support.",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "spectrum-scoop@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Spectrum Scoop",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
